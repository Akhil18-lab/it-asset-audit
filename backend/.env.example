# Server (local dev only — Vercel ignores PORT and sets its own)
PORT=5000
JWT_SECRET=change-this-to-a-random-secret-string

# Postgres connection string (from Supabase: Project Settings > Database >
# Connection string > "Transaction pooler" is recommended for serverless).
# e.g. postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Frontend URL (set this on Vercel to your frontend's deployment URL, for CORS)
# e.g. https://it-asset-audit.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Supabase project (for photo storage) — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=audit-photos

# Secures the /api/cron/audit-reminders endpoint. Set the same value here and
# as a Vercel env var — Vercel automatically sends it as the Authorization
# header when its Cron Jobs scheduler calls the endpoint.
CRON_SECRET=a-long-random-string

# Email (SMTP) — leave blank to use Ethereal test mode (no real emails, prints preview URLs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="IT Asset Audit" <your@gmail.com>

# Single address to receive all system notifications (schedule created, reviews, reminders)
NOTIFICATION_EMAIL=itmanager@yourcompany.com
