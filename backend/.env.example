# Server
PORT=5000
JWT_SECRET=change-this-to-a-random-secret-string

# Email (SMTP) — leave blank to use Ethereal test mode (no real emails, prints preview URLs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="IT Asset Audit" <your@gmail.com>

# Single address to receive all system notifications (schedule created, reviews, reminders)
NOTIFICATION_EMAIL=itmanager@yourcompany.com
